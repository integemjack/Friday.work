{
  "name": "friday-desktop-work",
  "version": "0.5.58",
  "description": "Friday 远程工作流客户端：SChat 扫码连入，WebRTC 工作通道（语音 / 视频 / 数据）",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Friday Desktop Work",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev -- --remote-debugging-port=9222 --user-data-dir=.dev-user-data",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node scripts/run-tests.cjs",
    "pack": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.node.json --composite false"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "~44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "markdown-it": "^14.1.0",
    "misans": "^5.0.0",
    "pinia": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.9.0": true,
    "electron-winstaller@5.4.0": true,
    "electron-builder@26.15.3": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
